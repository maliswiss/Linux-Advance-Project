# Logs and temp files
*.log
*.tmp
*.bak
*.swp
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.sublime-*

# Secrets and credentials (NEVER commit these!)
*.pem
*.key
.env
.env.local
credentials.txt
secrets.txt

